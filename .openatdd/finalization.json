{
  "schemaVersion": 1,
  "surface": "cli",
  "environment": "local",
  "source": {
    "include": ["**/*"],
    "exclude": ["evals/reports/**"]
  },
  "dryRun": {
    "commands": [
      {
        "id": "cli-help-smoke",
        "argv": ["node", "skills/openatdd/scripts/openatdd.mjs", "help"],
        "timeoutMs": 30000
      },
      {
        "id": "cli-status-smoke",
        "argv": ["node", "skills/openatdd/scripts/openatdd.mjs", "status", "strategy-visibility", "--json"],
        "timeoutMs": 30000
      }
    ],
    "checkHttpLinks": false,
    "linkTimeoutMs": 3000
  },
  "checks": [
    {
      "id": "focused-strategy",
      "name": "Strategy retrospective and evaluation regressions",
      "scope": "focused",
      "commands": [
        {
          "id": "focused-strategy-tests",
          "argv": ["node", "--test", "tests/strategy.test.mjs", "tests/agent-eval.test.mjs", "tests/intelligence-integration.test.mjs"],
          "timeoutMs": 120000
        }
      ]
    },
    {
      "id": "module-evaluations",
      "name": "OpenATDD deterministic and Agent evaluation corpus",
      "scope": "module",
      "commands": [
        {
          "id": "module-eval-suite",
          "argv": ["npm", "run", "eval"],
          "timeoutMs": 120000
        }
      ]
    },
    {
      "id": "broad-project",
      "name": "Complete OpenATDD project checks",
      "scope": "broad",
      "commands": [
        {
          "id": "broad-project-check",
          "argv": ["npm", "run", "check"],
          "timeoutMs": 180000
        }
      ]
    }
  ],
  "uat": {
    "estimatedRoundTrips": 3,
    "batches": [
      {
        "id": "default-no-interference",
        "name": "Normal delivery remains unchanged until retrospective is requested",
        "acceptanceIds": ["AC-01"],
        "reuseSession": true,
        "commands": [
          {
            "id": "uat-default-no-interference",
            "argv": ["node", "--test", "tests/strategy.test.mjs", "tests/workflow.test.mjs"],
            "timeoutMs": 120000
          }
        ]
      },
      {
        "id": "manual-retrospective",
        "name": "Manual retrospective explains selected and observed capabilities with evidence",
        "acceptanceIds": ["AC-02", "AC-03"],
        "reuseSession": true,
        "commands": [
          {
            "id": "uat-manual-retrospective",
            "argv": ["node", "skills/openatdd/scripts/openatdd.mjs", "retrospect", "strategy-visibility", "--eval-report", "evals/reports/strategy-visibility-real.json", "--json"],
            "timeoutMs": 30000
          }
        ]
      },
      {
        "id": "evaluation-effect",
        "name": "Full, bare, and capability-ablation outcomes support bounded optimization conclusions",
        "acceptanceIds": ["AC-04"],
        "reuseSession": true,
        "commands": [
          {
            "id": "uat-strategy-real-agent-report",
            "argv": ["node", "skills/openatdd/scripts/agent-eval.mjs", "--verify-report", "evals/reports/strategy-visibility-real.json", "--min-runs", "2", "--require-baseline", "--require-ablation", "risk-research"],
            "timeoutMs": 30000
          },
          {
            "id": "uat-agent-evaluation",
            "argv": ["node", "--test", "tests/agent-eval.test.mjs"],
            "timeoutMs": 120000
          },
          {
            "id": "uat-package-dry-run",
            "argv": ["npm", "pack", "--dry-run", "--json"],
            "timeoutMs": 120000
          },
          {
            "id": "uat-official-skill-validation",
            "argv": ["node", "-e", "const {spawnSync}=require('node:child_process');const path=require('node:path');const os=require('node:os');const script=path.join(os.homedir(),'.codex','skills','.system','skill-creator','scripts','quick_validate.py');const result=spawnSync('uv',['run','--with','pyyaml','python',script,'skills/openatdd'],{stdio:'inherit'});process.exit(result.status??1)"],
            "timeoutMs": 120000
          }
        ]
      }
    ]
  },
  "acceptance": {
    "AC-01": ["check:broad-project", "batch:default-no-interference"],
    "AC-02": ["check:broad-project", "batch:manual-retrospective"],
    "AC-03": ["check:focused-strategy", "check:broad-project", "batch:manual-retrospective"],
    "AC-04": ["check:module-evaluations", "check:broad-project", "batch:evaluation-effect"]
  },
  "history": {
    "mode": "deferred",
    "overrides": [
      {
        "taskId": "detailed-uat-handoff",
        "acceptanceIds": ["AC-01", "AC-02", "AC-03", "AC-04", "AC-05", "AC-06", "AC-07"],
        "evidenceFrom": ["check:broad-project", "batch:default-no-interference", "batch:manual-retrospective", "batch:evaluation-effect"]
      },
      {
        "taskId": "fast-portable-finalization",
        "acceptanceIds": ["AC-01", "AC-02", "AC-03", "AC-04", "AC-05", "AC-06", "AC-07", "AC-08"],
        "evidenceFrom": ["check:broad-project", "batch:default-no-interference", "batch:manual-retrospective", "batch:evaluation-effect"]
      },
      {
        "taskId": "openatdd-1-0",
        "acceptanceIds": ["AC-01", "AC-02", "AC-03", "AC-04", "AC-05", "AC-06", "AC-07", "AC-08"],
        "evidenceFrom": ["check:broad-project", "batch:default-no-interference", "batch:manual-retrospective", "batch:evaluation-effect"]
      },
      {
        "taskId": "openatdd-mvp",
        "acceptanceIds": ["AC-01", "AC-02", "AC-03", "AC-04", "AC-05", "AC-06", "AC-07", "AC-08", "AC-09"],
        "evidenceFrom": ["check:broad-project", "batch:default-no-interference", "batch:manual-retrospective", "batch:evaluation-effect"]
      }
    ]
  },
  "handoff": {
    "estimatedMinutes": 10
  },
  "budgets": {
    "wallTimeMs": 300000,
    "commandInvocations": 15,
    "browserRoundTrips": 3,
    "evidenceWrites": 37
  }
}
