{
  "schemaVersion": 1,
  "surface": "cli",
  "environment": "local",
  "source": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "evals/reports/**"
    ]
  },
  "preflight": {
    "scope": "project",
    "reason": "The approved journey uses only the deterministic local CLI and Node test harness."
  },
  "dryRun": {
    "commands": [
      {
        "id": "cli-help-smoke",
        "argv": [
          "node",
          "skills/openatdd/scripts/openatdd.mjs",
          "help"
        ],
        "deterministic": true,
        "timeoutMs": 30000
      }
    ],
    "checkHttpLinks": false
  },
  "checks": [
    {
      "id": "focused-agent-eval",
      "name": "Bundled Codex adapter configuration regressions",
      "scope": "focused",
      "commands": [
        {
          "id": "focused-agent-eval-tests",
          "argv": [
            "node",
            "--test",
            "tests/agent-eval.test.mjs"
          ],
          "deterministic": true,
          "timeoutMs": 120000
        }
      ]
    },
    {
      "id": "broad-project",
      "name": "Complete OpenATDD project checks",
      "scope": "broad",
      "commands": [
        {
          "id": "broad-project-check",
          "argv": [
            "npm",
            "run",
            "check"
          ],
          "deterministic": true,
          "timeoutMs": 180000
        }
      ]
    }
  ],
  "uat": {
    "estimatedRoundTrips": 1,
    "batches": [
      {
        "id": "user-config-journey",
        "name": "User provider remains default and isolation stays explicit and auditable",
        "acceptanceIds": [
          "AC-01",
          "AC-02",
          "AC-03"
        ],
        "reuseSession": true,
        "commands": [
          {
            "id": "uat-agent-eval-tests",
            "argv": [
              "node",
              "--test",
              "tests/agent-eval.test.mjs"
            ],
            "deterministic": true,
            "timeoutMs": 120000
          },
          {
            "id": "uat-cli-help",
            "argv": [
              "node",
              "-e",
              "const {spawnSync}=require('node:child_process');const commands=[['skills/openatdd/scripts/openatdd.mjs','help'],['skills/openatdd/scripts/agent-eval.mjs','--help'],['skills/openatdd/scripts/codex-agent-adapter.mjs','--help']];for(const args of commands){const result=spawnSync(process.execPath,args,{encoding:'utf8'});if(result.status!==0||!result.stdout.includes('--isolated-config'))process.exit(1)}"
            ],
            "deterministic": true,
            "timeoutMs": 30000
          }
        ]
      }
    ]
  },
  "acceptance": {
    "AC-01": [
      "check:focused-agent-eval",
      "batch:user-config-journey"
    ],
    "AC-02": [
      "check:focused-agent-eval",
      "batch:user-config-journey"
    ],
    "AC-03": [
      "check:broad-project",
      "batch:user-config-journey"
    ]
