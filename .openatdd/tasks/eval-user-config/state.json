  "taskId": "eval-user-config",
  "requirement": "Allow bundled Codex agent evaluations to opt into the current user config so configured providers and quotas are preserved.",
  "phase": "DELIVERED",
  "createdAt": "2026-07-28T02:44:44.409Z",
