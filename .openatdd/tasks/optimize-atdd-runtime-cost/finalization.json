{
  "schemaVersion": 1,
  "surface": "cli",
  "environment": "local",
  "source": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "evals/reports/**"
    ]
  },
  "preflight": {
    "scope": "project",
    "reason": "The approved optimization, browser routing, and real-model report verification run entirely in deterministic local Node.js harnesses without a live service or production account."
  },
  "dryRun": {
    "commands": [
      {
        "id": "cli-help-smoke",
        "argv": [
          "node",
          "skills/openatdd/scripts/openatdd.mjs",
          "help"
        ],
        "deterministic": true,
        "timeoutMs": 30000
      }
    ],
    "checkHttpLinks": false
  },
  "checks": [
    {
      "id": "focused-runtime-cost",
      "name": "Runtime profile, report, command lifecycle, and browser routing regressions",
      "scope": "focused",
      "commands": [
        {
          "id": "focused-runtime-cost-tests",
          "argv": [
            "node",
            "--test",
            "tests/agent-eval.test.mjs",
            "tests/intelligence.test.mjs",
            "tests/delivery-v2.test.mjs"
          ],
          "deterministic": true,
          "timeoutMs": 120000
        }
      ]
    },
    {
      "id": "module-optimized-evaluation",
      "name": "Optimized real-model reports and mechanical cost thresholds",
      "scope": "module",
      "commands": [
        {
          "id": "module-simple-optimized-report",
          "argv": [
            "node",
            "skills/openatdd/scripts/openatdd.mjs",
            "agent-eval",
            "--verify-report",
            "evals/reports/delivery-simple-optimized.json",
            "--min-runs",
            "2",
            "--require-profile",
            "bare",
            "--require-profile",
            "thin-atdd",
            "--require-profile",
            "full-openatdd"
          ],
          "deterministic": true,
          "timeoutMs": 30000
        },
        {
          "id": "module-medium-optimized-report",
          "argv": [
            "node",
            "skills/openatdd/scripts/openatdd.mjs",
            "agent-eval",
            "--verify-report",
            "evals/reports/delivery-medium-optimized.json",
            "--min-runs",
            "2",
            "--require-profile",
            "bare",
            "--require-profile",
            "thin-atdd",
            "--require-profile",
            "full-openatdd"
          ],
          "deterministic": true,
          "timeoutMs": 30000
        },
        {
          "id": "module-complex-optimized-report",
          "argv": [
            "node",
            "skills/openatdd/scripts/openatdd.mjs",
            "agent-eval",
            "--verify-report",
            "evals/reports/delivery-complex-optimized.json",
            "--min-runs",
            "2",
            "--require-profile",
            "bare",
            "--require-profile",
            "thin-atdd",
            "--require-profile",
            "full-openatdd"
          ],
          "deterministic": true,
          "timeoutMs": 30000
        },
        {
          "id": "module-optimization-thresholds",
          "argv": [
            "node",
            "skills/openatdd/scripts/openatdd.mjs",
            "agent-eval",
            "--compare-baseline",
            "evals/reports/delivery-summary.json",
            "--compare-candidate",
            "evals/reports/delivery-summary-optimized.json",
            "--comparison-json",
            "evals/reports/delivery-optimization.json",
            "--comparison-markdown",
            "evals/reports/delivery-optimization.md",
            "--enforce-optimization"
          ],
          "deterministic": true,
          "timeoutMs": 30000
        }
      ]
    },
    {
      "id": "broad-project",
      "name": "Complete OpenATDD project checks",
      "scope": "broad",
      "commands": [
        {
          "id": "broad-project-check",
          "argv": [
            "npm",
            "run",
            "check"
          ],
          "timeoutMs": 180000
        }
      ]
    }
  ],
