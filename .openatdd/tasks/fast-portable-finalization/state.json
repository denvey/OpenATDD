  "issues": [
    {
      "id": "ISSUE-001",
      "acceptanceId": "AC-06",
      "status": "resolved",
      "symptom": "Legacy projects without .openatdd/reverification/index.json fail during deferred historical finalization instead of initializing an empty cache index.",
      "evidence": [
        {
          "path": ".openatdd/tasks/fast-portable-finalization/evidence/repair-missing-reverification-index.md",
          "sha256": "2e07b7ecec827c7a3e4f153e4a6fc3f9ff0401c74f017258a5444077916cbfb2",
          "size": 432,
          "modifiedAt": "2026-07-23T12:45:50.976Z",
          "capturedAt": "2026-07-23T12:46:00.491Z"
        }
      ],
      "openedAt": "2026-07-23T12:45:14.679Z",
      "rootCause": "The finalizer assumed the v0.3 reverification cache index had already been created, but resumed legacy repositories can predate that runtime artifact.",
      "regression": [
        "affected history initializes a missing reverification index and recreates it atomically"
      ],
      "invariant": "Historical finalization treats an absent runtime cache as an empty cache; cache presence is never a prerequisite for delivery.",
      "paths": [
        "skills/openatdd/scripts/finalization.mjs",
        "tests/finalization.test.mjs"
      ],
      "resolvedAt": "2026-07-23T12:46:00.490Z",
      "memoryId": "INC-2026-005"
    }
  ],
