{
  "schemaVersion": 3,
  "deliveryVersion": 3,
  "taskId": "strategy-visibility",
  "requirement": "增加一个默认关闭的策略可见性开关；打开后在执行过程中显示当前采用的 OpenATDD 能力组合、借鉴来源、启用原因、未启用能力及效果指标，并支持完整、裸 Agent 和能力消融对照评测。",
  "phase": "READY_FOR_UAT",
  "createdAt": "2026-07-24T03:10:15.553Z",
  "updatedAt": "2026-07-24T03:56:40.047Z",
  "acceptance": {
    "approvedAt": "2026-07-24T03:33:07.161Z",
    "sha256": "707a6526765e029dbab465909fa303cd16a45e7d4159503af06d1d0a77cfb4ca",
    "items": [
      {
        "id": "AC-01",
        "classification": "AUTO",
        "blocking": true,
        "title": "正常执行保持零额外干扰",
        "given": "已初始化的 OpenATDD 项目正在交付任务。",
        "when": "任务完成路由、实现、验证和 finalization。",
        "then": "运行过程中不增加策略播报、问题、Token 上下文或确认步骤；未请求回溯时，现有 1.0 体验保持不变。",
        "evidence": "兼容性、交互轮次和默认 CLI 输出回归测试。"
      },
      {
        "id": "AC-02",
        "classification": "ASSISTED",
        "blocking": true,
        "title": "完成后按需生成可理解的策略回溯",
        "given": "任务已有路由、执行或验收状态。",
        "when": "开发者请求回溯本次采用的方案。",
        "then": "用当前对话语言生成一份简短报告，说明任务深度、选择理由、能力借鉴来源、策略选择、实际调用、未调用项及原因，并明确不展示内部思维链。",
        "evidence": "Quick、Standard、Deep 回溯快照，真实 CLI 输出和人工可读性判断。"
      },
      {
        "id": "AC-03",
        "classification": "AUTO",
        "blocking": true,
        "title": "实际调用、效果和证据可追溯",
        "given": "任务产生 Agent、调研、审查、恢复、finalization 或评测记录。",
        "when": "开发者生成策略回溯或机器可读输出。",
        "then": "报告只从确定性状态和证据派生，展示实际 Agent/审查/恢复记录及可用的人类轮次、首次验收、Token、缓存 Token、耗时和通过率；每项结论可链接到来源，缺失指标明确标为不可用。",
        "evidence": "状态派生、指标聚合、缓存 Token 和缺失值回归测试。"
      },
      {
        "id": "AC-04",
        "classification": "ASSISTED",
        "blocking": true,
        "title": "对照评测能说明效果并给出优化建议",
        "given": "存在完整 OpenATDD、裸 Agent 和一个或多个能力消融配置。",
        "when": "同一版本化场景重复运行并生成对照报告。",
        "then": "报告列出每组启用能力、通过率、人类交互、过度设计、合同违规、Token/时间及相对差异，并依据证据提出“保留、减少、关闭或继续观察”的建议；不因单个场景得分相同就宣称框架更优。",
        "evidence": "版本化消融配置、隐藏检查、对照报告和人工结论判断。"
      }
    ]
  },
