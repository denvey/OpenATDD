{
  "schemaVersion": 3,
  "deliveryVersion": 3,
  "taskId": "end-to-end-agent-eval",
  "requirement": "重新设计并运行简单、中等、复杂三类端到端 Agent 评测，对比裸 Agent、精简 ATDD 核心和完整 OpenATDD，衡量真实实现、AI 预验收质量、人工验收准备度、耗时与 token。",
  "phase": "DELIVERED",
  "createdAt": "2026-07-28T16:03:46.259Z",
  "updatedAt": "2026-07-29T16:57:52.100Z",
  "acceptance": {
    "approvedAt": "2026-07-28T16:13:16.402Z",
    "sha256": "ba2a9ae6723bd7dba833d07b59904477a522fa869aebb3b9a8cda20746c026a5",
    "items": [
      {
        "id": "AC-01",
        "classification": "AUTO",
        "blocking": true,
        "title": "三种难度都执行公平的三组端到端对照",
        "given": "存在简单、中等和复杂三个版本化场景，每个场景包含可独立复制的小型种子项目和面向用户的一句需求。",
        "when": "分别对裸 Agent、精简 ATDD 核心和完整 OpenATDD 运行同一场景。",
        "then": "三组使用相同模型、推理强度、用户配置、超时和重复次数，工作区彼此隔离；报告明确记录三种 profile 及场景难度。",
        "evidence": "场景定义、profile 指纹、评测报告和隔离工作区回归测试。"
      },
      {
        "id": "AC-02",
        "classification": "AUTO",
        "blocking": true,
        "title": "评测真实实现与预验收而非只输出计划",
        "given": "三个种子项目都包含可观察的用户结果和仅评测器可见的功能检查。",
        "when": "Agent 在可写工作区中读取、修改并验证代码，然后结束交付。",
        "then": "Agent 可以正常使用工具和项目命令；隐藏检查只在 Agent 结束后运行，并从实际工作区判断功能是否完成。",
        "evidence": "评测适配器回归测试、Agent 工具执行记录、修改后工作区和隐藏检查结果。"
      },
      {
        "id": "AC-03",
        "classification": "AUTO",
        "blocking": true,
        "title": "裸基线不再收到 OpenATDD 答案线索",
        "given": "评测器需要为三组提供必要的运行与结果采集协议。",
        "when": "构建裸 Agent 提示与隐藏验收。",
        "then": "公共提示不包含 Quick / Standard / Deep、预期技术方案、决策 ID、隐藏检查关键词或 OpenATDD 特有步骤；裸组只依靠模型默认工程能力。",
        "evidence": "生成提示快照、禁止线索回归测试和场景隐藏检查。"
      },
      {
        "id": "AC-04",
        "classification": "AUTO",
        "blocking": true,
        "title": "精简 ATDD 核心是有界的可识别 profile",
        "given": "需要测量验收优先核心能力，而不是再注入完整 529 行 Skill。",
        "when": "运行精简 ATDD 组。",
        "then": "精简 profile 只要求 AI 从用户需求推导验收结果、保留技术方案检查点、实现、执行预验收并准备人工 UAT；内容独立版本化且报告保存字节数与摘要指纹。",
        "evidence": "精简 profile 文件、长度与摘要回归测试、评测报告。"
      },
      {
        "id": "AC-05",
        "classification": "AUTO",
        "blocking": true,
        "title": "报告区分真实成功、自验收和错误就绪声明",
        "given": "Agent 可能运行检查、不运行检查，或在最终功能仍错误时宣称已完成。",
        "when": "评测器采集 Agent 工具记录、最终交付和独立隐藏检查。",
        "then": "每次运行至少记录功能通过、是否执行自验收、宣称就绪状态、错误就绪声明和交接可用性；不把模型自述当作功能通过证据。",
        "evidence": "报告字段、通过/失败 fixture、隐藏检查和错误就绪判定回归测试。"
      },
      {
        "id": "AC-06",
        "classification": "AUTO",
        "blocking": true,
        "title": "报告完整比较质量与成本",
        "given": "同一场景的三个 profile 均完成指定次数的真实模型运行。",
        "when": "生成并验证对照报告。",
        "then": "报告按场景和 profile 列出功能通过率、错误就绪率、自验收率、交接可用性、总耗时、输入/缓存/非缓存/输出 Token 及组间差异，并明示样本数与模型配置。",
        "evidence": "真实模型报告、报告验证器和汇总输出。"
      },
      {
        "id": "AC-07",
        "classification": "AUTO",
        "blocking": true,
        "title": "新评测不破坏现有可重现能力",
        "given": "项目已有 planning-only 场景、mock / command / Codex 适配器、报告验证和用户 provider 配置。",
        "when": "增加端到端评测模式并运行项目检查。",
        "then": "现有 schema v1 场景、CLI 用法和 mock 回归继续通过；三组仍共享用户 provider 或共同使用显式隔离配置，配置模式记录在报告中。",
        "evidence": "现有评测回归、CLI 进程测试、完整项目检查和 provider 探测证据。"
      }
    ]
  },
