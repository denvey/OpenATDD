{
  "schemaVersion": 3,
  "deliveryVersion": 3,
  "taskId": "lightweight-project-truth",
  "requirement": "为 OpenATDD 增加精简的项目事实层，让后续开发自动获得当前产品规则、架构边界和关键技术决策，同时保持低 Token、避免重型文档流程",
  "phase": "DELIVERED",
  "createdAt": "2026-07-29T16:03:15.021Z",
  "updatedAt": "2026-07-29T16:58:32.389Z",
  "acceptance": {
    "approvedAt": "2026-07-29T16:26:19.132Z",
    "sha256": "bb137c81f62a7dbe5e24eef9a6938f6e37c2c0dbb23f49d9e0f5b58c266924e5",
    "items": [
      {
        "id": "AC-01",
        "classification": "AUTO",
        "blocking": true,
        "title": "初始化产生单一、精简且可安全维护的项目事实源",
        "given": "一个新项目或已有 `.openatdd/` 的旧项目。",
        "when": "执行 `openatdd init`。",
        "then": "存在一份带有产品规则、架构边界、关键技术决策三个明确区域的项目事实模板；重复初始化不覆盖人工内容，也不新增审批或文档层级。",
        "evidence": "初始化与重复初始化的确定性测试，以及生成文件断言。"
      },
      {
        "id": "AC-02",
        "classification": "AUTO",
        "blocking": true,
        "title": "后续任务自动获得当前项目事实",
        "given": "项目事实文件中已经填写可识别的当前规则。",
        "when": "创建并评估新任务，或构建该任务的作用域上下文。",
        "then": "任务的实现与验证上下文都包含一个来源可追溯的 `ProjectTruth` 引用，无需人工再查询；CLI 只返回精简元数据，不复制整份正文到任务状态或输出。",
        "evidence": "任务创建、知识检索和 `context-build` 集成测试。"
      },
      {
        "id": "AC-03",
        "classification": "AUTO",
        "blocking": true,
        "title": "项目事实变更会使派生认知自动更新",
        "given": "任务上下文和知识图谱已经从项目事实构建完成。",
        "when": "修改项目事实文件中的一条当前规则并再次加载上下文或图谱。",
        "then": "来源摘要发生变化，旧上下文被判定为 stale，重建后只能看到新的当前事实；项目事实仍是唯一事实源，图谱只是可重建索引。",
        "evidence": "图谱 stale、上下文 stale 与重建测试。"
      },
      {
        "id": "AC-04",
        "classification": "AUTO",
        "blocking": true,
        "title": "保持兼容、低开销和原有长期记忆能力",
        "given": "旧项目没有项目事实文件，或项目已有 incident、invariant、standard、research 数据。",
        "when": "升级后执行现有工作流和完整测试。",
        "then": "旧项目可自动补齐模板且继续运行；原有记忆、历史影响与检索不退化；不引入模型调用、外部服务、数据库、Vision/Epic/Issue 层级或新的人工确认。",
        "evidence": "现有知识/工作流回归测试与项目完整检查。"
      }
    ]
  },
