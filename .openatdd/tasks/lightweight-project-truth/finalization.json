{
  "schemaVersion": 1,
  "surface": "cli",
  "environment": "local",
  "source": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "evals/reports/**"
    ]
  },
  "preflight": {
    "scope": "project",
    "reason": "The approved journey uses the deterministic local CLI and Node.js test harness with no live service dependency."
  },
  "dryRun": {
    "commands": [
      {
        "id": "project-truth-cli-help",
        "argv": [
          "node",
          "skills/openatdd/scripts/openatdd.mjs",
          "help"
        ],
        "timeoutMs": 30000
      }
    ],
    "checkHttpLinks": false
  },
  "checks": [
    {
      "id": "focused-project-truth",
      "name": "Project truth initialization, graph, context, and CLI regressions",
      "scope": "focused",
      "commands": [
        {
          "id": "focused-project-truth-tests",
          "argv": [
            "node",
            "--test",
            "tests/knowledge.test.mjs",
            "tests/workflow.test.mjs"
          ],
          "timeoutMs": 120000
        }
      ]
    },
    {
      "id": "module-intelligence",
      "name": "OpenATDD knowledge and workflow integration",
      "scope": "module",
      "commands": [
        {
          "id": "module-intelligence-tests",
          "argv": [
            "node",
            "--test",
            "tests/intelligence.test.mjs",
            "tests/intelligence-integration.test.mjs",
            "tests/delivery-v2.test.mjs"
          ],
          "timeoutMs": 120000
        }
      ]
    },
    {
      "id": "broad-project",
      "name": "Complete OpenATDD project checks",
      "scope": "broad",
      "commands": [
        {
          "id": "broad-project-check",
          "argv": [
            "npm",
            "run",
            "check"
          ],
          "timeoutMs": 180000
        }
      ]
    }
  ],
  "uat": {
    "estimatedRoundTrips": 1,
    "batches": [
      {
        "id": "project-truth-journey",
        "name": "Initialize, retrieve, stale, rebuild, and preserve project truth",
        "acceptanceIds": [
          "AC-01",
          "AC-02",
          "AC-03",
          "AC-04"
        ],
        "reuseSession": true,
        "commands": [
          {
            "id": "uat-project-truth-journey",
            "argv": [
              "node",
              "--test",
              "tests/knowledge.test.mjs",
              "tests/workflow.test.mjs"
            ],
            "timeoutMs": 120000
          }
        ]
      }
    ]
  },
  "acceptance": {
    "AC-01": [
      "check:focused-project-truth",
      "check:broad-project",
      "batch:project-truth-journey"
    ],
    "AC-02": [
      "check:focused-project-truth",
      "check:module-intelligence",
      "check:broad-project",
      "batch:project-truth-journey"
    ],
    "AC-03": [
      "check:focused-project-truth",
      "check:broad-project",
      "batch:project-truth-journey"
    ],
    "AC-04": [
      "check:module-intelligence",
      "check:broad-project",
      "batch:project-truth-journey"
    ]
  },
  "history": {
    "mode": "deferred",
    "overrides": [
      {
        "taskId": "detailed-uat-handoff",
        "acceptanceIds": [
          "AC-01",
          "AC-02",
          "AC-03",
          "AC-04",
          "AC-05",
          "AC-06",
          "AC-07"
        ],
        "evidenceFrom": [
          "check:broad-project",
          "batch:project-truth-journey"
        ]
      },
      {
        "taskId": "openatdd-mvp",
        "acceptanceIds": [
          "AC-01",
          "AC-02",
          "AC-03",
          "AC-04",
          "AC-05",
          "AC-06",
          "AC-07",
          "AC-08",
          "AC-09"
        ],
        "evidenceFrom": [
          "check:broad-project",
          "batch:project-truth-journey"
        ]
      }
    ]
  },
  "handoff": {
    "estimatedMinutes": 5
  },
  "budgets": {
    "wallTimeMs": 300000,
    "commandInvocations": 50,
    "browserRoundTrips": 1,
    "evidenceWrites": 100
  }
}
