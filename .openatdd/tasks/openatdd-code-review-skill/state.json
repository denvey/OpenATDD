{
  "schemaVersion": 3,
  "deliveryVersion": 3,
  "taskId": "openatdd-code-review-skill",
  "requirement": "基于 OpenATDD 的验收卡、方案卡和项目规范创建一个轻量只读 Code Review Skill，稳定输出有证据、可操作、按严重级别排序的审查 finding，并与后续修复工作流衔接。",
  "phase": "DELIVERED",
  "createdAt": "2026-07-29T00:24:59.787Z",
  "updatedAt": "2026-07-29T16:58:15.091Z",
  "acceptance": {
    "approvedAt": "2026-07-29T00:29:08.761Z",
    "sha256": "8baad4a497019a4e330d02724a8f29c4560f61182240278919358e91e81acde0",
    "items": [
      {
        "id": "AC-01",
        "classification": "AUTO",
        "blocking": true,
        "title": "审查优先对照已批准的 OpenATDD 合同",
        "given": "目标改动关联一个已有验收卡和方案卡的 OpenATDD task。",
        "when": "使用新 Skill 审查指定 diff。",
        "then": "审查明确区分“是否符合验收/方案”和“代码本身是否正确”，能够指出漏做、错误实现和未要求的范围扩张；仓库规范优先于通用偏好。",
        "evidence": "Skill 契约测试与包含合同偏差的前向评测样例。"
      },
      {
        "id": "AC-02",
        "classification": "AUTO",
        "blocking": true,
        "title": "无 OpenATDD task 时仍可安全回退",
        "given": "目标改动没有可定位的 OpenATDD task。",
        "when": "使用 PR/issue/用户描述和仓库规范执行 Review。",
        "then": "AI 不伪造需求；能找到规格就继续，规格缺失时只审查可证明的正确性与风险，并明确“需求符合度未验证”。",
        "evidence": "无 task、有 PR 规格和完全无规格三种契约测试。"
      },
      {
        "id": "AC-03",
        "classification": "AUTO",
        "blocking": true,
        "title": "Findings 有统一严重级别和证据门槛",
        "given": "diff 中包含可复现或可由调用路径证明的问题，同时包含只属于格式偏好的噪声。",
        "when": "执行 Review 并生成结果。",
        "then": "每条 finding 包含 P0～P3、标题、紧凑 `file:line`、触发条件、实际影响、代码/测试证据和最小修复或验证方向；按严重性排序，不报告 formatter/linter 可处理的问题，不把猜测写成确定缺陷。",
        "evidence": "输出结构测试、误报抑制样例和行号校验。"
      },
      {
        "id": "AC-04",
        "classification": "AUTO",
        "blocking": true,
        "title": "Review 全程只读且结果诚实",
        "given": "用户只要求 Code Review。",
        "when": "Skill 检查 diff、调用路径和相关测试。",
        "then": "不修改文件、提交、PR、评论或 OpenATDD 状态；只运行非变异检查。没有 actionable finding 时明确报告“未发现阻塞问题”，并列出测试缺口或未验证边界，而不是制造意见。",
        "evidence": "只读约束测试、工作区哈希对比与无 finding 样例。"
      },
      {
        "id": "AC-05",
        "classification": "AUTO",
        "blocking": true,
        "title": "修复请求与 OpenATDD 问题流衔接",
        "given": "Review 已产生有效 finding，用户随后明确要求修复。",
        "when": "继续处理该 finding。",
        "then": "已有相关 task 时进入其 issue/repair 流；否则按复杂度创建新的 Bug 修复任务；保留根因、回归保护和验收证据，不在 Review 阶段偷跑实现。",
        "evidence": "Skill 路由文本、OpenATDD 回归测试和模拟 Review→Fix 旅程。"
      },
      {
        "id": "AC-06",
        "classification": "AUTO",
        "blocking": true,
        "title": "Skill 轻量、可安装且不重复 OpenATDD 内核",
        "given": "仓库通过软链和 npm 包向 Codex 提供 Skills。",
        "when": "构建并验证 `openatdd-code-review` Skill。",
        "then": "核心 `SKILL.md` 不超过 4,096 字节；只引用现有 OpenATDD 工件和 CLI，不复制完整运行内核；包含匹配的 `agents/openai.yaml`，进入 npm 包并通过全局软链可从其他项目触发。",
        "evidence": "字节数、Skill Creator 校验、包清单、软链解析和仓库外触发检查。"
      }
    ]
  },
