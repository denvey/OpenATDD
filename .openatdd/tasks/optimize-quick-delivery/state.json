{
  "schemaVersion": 3,
  "deliveryVersion": 3,
  "taskId": "optimize-quick-delivery",
  "requirement": "优化 Quick 小改动的检索、验证与最终化路径，避免无关读取、重复 dry-run、伪造 preflight 证据和已知失败的全量检查",
  "phase": "DELIVERED",
  "createdAt": "2026-07-25T22:31:18.449Z",
  "updatedAt": "2026-07-29T16:58:26.495Z",
  "acceptance": {
    "approvedAt": "2026-07-25T22:35:24.463Z",
    "sha256": "abb37bba0b5fbdd49dfc2b1f5fafb6ece2790e58788f5fe8146c2c5b93aa9929",
    "items": [
      {
        "id": "AC-01",
        "classification": "AUTO",
        "blocking": true,
        "title": "Quick 指令采用最小默认工作预算",
        "given": "任务位置已知、改动局部、模式成熟且可逆。",
        "when": "Agent 按 OpenATDD Quick 指令执行检索、读取、修改和验证。",
        "then": "默认只进行一次定位、一次目标批量读取、一个最小补丁、相关检查和一次差异检查；语义搜索、CodeGraph、无关架构资料、已知失败的全量检查和子代理仅在有明确理由时使用。",
        "evidence": "Skill 与 README 的约束测试和文本检查。"
      },
      {
        "id": "AC-02",
        "classification": "AUTO",
        "blocking": true,
        "title": "最终化清单可在执行前静态校验",
        "given": "任务已有批准的验收与方案，且存在候选最终化清单。",
        "when": "运行 `openatdd validate-finalization <task>`。",
        "then": "命令在不执行 smoke、check、UAT、不写 preview 的情况下返回完整的 schema、验收映射与清单路径校验结果；无效清单返回非零状态。",
        "evidence": "CLI 与 finalization 单元测试。"
      },
      {
        "id": "AC-03",
        "classification": "AUTO",
        "blocking": true,
        "title": "任务级清单优先于项目级清单",
        "given": "任务目录存在 `finalization.json`，项目根目录也存在旧任务清单。",
        "when": "未显式传入 `--manifest` 时校验或最终化当前任务。",
        "then": "OpenATDD 选择任务级清单；没有任务级清单时保持项目级回退，显式参数仍具有最高优先级。",
        "evidence": "manifest 路径解析测试。"
      },
      {
        "id": "AC-04",
        "classification": "AUTO",
        "blocking": true,
        "title": "组件级验证无需伪造运行环境证据",
        "given": "清单显式声明 `preflight.scope: project` 并提供原因，环境档案仍包含角色、组织、集成或 fixture 信息。",
        "when": "执行静态校验和最终化预检。",
        "then": "工作区、项目和启动命令等项目事实仍被校验；服务、入口、登录、组织、集成、fixture 与 workaround 被标记为不适用且不要求 assertions/evidence；默认 `environment` 范围保持原有严格行为。",
        "evidence": "manifest、profile preflight 与 finalization 回归测试。"
      }
    ]
  },
