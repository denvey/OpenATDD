{
  "schemaVersion": 1,
  "surface": "cli",
  "environment": "local",
  "source": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "evals/reports/**"
    ]
  },
  "preflight": {
    "scope": "project",
    "reason": "The approved journey is fully observable through deterministic Node.js tests and CLI/package validation with no live service dependency."
  },
  "dryRun": {
    "commands": [
      {
        "id": "cli-help-smoke",
        "argv": [
          "node",
          "skills/openatdd/scripts/openatdd.mjs",
          "help"
        ],
        "timeoutMs": 30000
      },
      {
        "id": "cli-task-status",
        "argv": [
          "node",
          "skills/openatdd/scripts/openatdd.mjs",
          "status",
          "acceptance-outcome-routing",
          "--json"
        ],
        "timeoutMs": 30000
      }
    ],
    "checkHttpLinks": false,
    "linkTimeoutMs": 3000
  },
  "checks": [
    {
      "id": "focused-delivery",
      "name": "Delivery state, report, and objection regressions",
      "scope": "focused",
      "commands": [
        {
          "id": "focused-delivery-tests",
          "argv": [
            "node",
            "--test",
            "tests/workflow.test.mjs",
            "tests/finalization.test.mjs",
            "tests/delivery-v2.test.mjs"
          ],
          "timeoutMs": 120000
        }
      ]
    },
    {
      "id": "module-delivery",
      "name": "Delivery state, strategy, and evaluation integration",
      "scope": "module",
      "commands": [
        {
          "id": "module-delivery-tests",
          "argv": [
            "node",
            "--test",
            "tests/workflow.test.mjs",
            "tests/finalization.test.mjs",
            "tests/delivery-v2.test.mjs",
            "tests/strategy.test.mjs",
            "tests/evals.test.mjs"
          ],
          "timeoutMs": 120000
        }
      ]
    },
    {
      "id": "broad-project",
      "name": "Complete OpenATDD project checks",
      "scope": "broad",
      "commands": [
        {
          "id": "broad-project-check",
          "argv": [
            "npm",
            "run",
            "check"
          ],
          "timeoutMs": 180000
        }
      ]
    }
  ],
  "uat": {
    "estimatedRoundTrips": 3,
    "batches": [
      {
        "id": "automatic-delivery",
        "name": "Automatic and API-style results deliver evidence without repeated UAT",
        "acceptanceIds": [
          "AC-01",
          "AC-02"
        ],
        "reuseSession": true,
        "commands": [
          {
            "id": "uat-automatic-delivery",
            "argv": [
              "node",
              "--test",
              "--test-name-pattern=commits one complete journey|prepares ASSISTED evidence|automatic handoff avoids repeated UAT",
              "tests/finalization.test.mjs",
              "tests/delivery-v2.test.mjs"
            ],
            "timeoutMs": 120000
          }
        ]
      },
      {
        "id": "manual-objection",
        "name": "Manual UAT remains report-only and objections reopen repair",
        "acceptanceIds": [
          "AC-03",
          "AC-04"
        ],
        "reuseSession": true,
        "commands": [
          {
            "id": "uat-manual-objection",
            "argv": [
              "node",
              "--test",
              "--test-name-pattern=blocking MANUAL acceptance|later objection reopens repair",
              "tests/finalization.test.mjs",
              "tests/workflow.test.mjs"
            ],
            "timeoutMs": 120000
          }
        ]
      },
      {
        "id": "compatibility-package",
        "name": "Legacy state, documentation, package, and Skill remain compatible",
        "acceptanceIds": [
          "AC-05"
        ],
        "reuseSession": true,
        "commands": [
          {
            "id": "uat-delivery-compatibility",
            "argv": [
              "node",
              "--test",
              "--test-name-pattern=new and legacy delivery phases|Skill metadata",
              "tests/workflow.test.mjs",
              "tests/code-review-skill.test.mjs"
            ],
            "timeoutMs": 120000
          },
          {
            "id": "uat-package-dry-run",
            "argv": [
              "npm",
              "pack",
              "--dry-run",
              "--json"
            ],
            "timeoutMs": 120000
          },
          {
            "id": "uat-skill-validation",
            "argv": [
              "node",
              "-e",
              "const {spawnSync}=require('node:child_process');const path=require('node:path');const os=require('node:os');const script=path.join(os.homedir(),'.codex','skills','.system','skill-creator','scripts','quick_validate.py');const result=spawnSync('uv',['run','--with','pyyaml','python',script,'skills/openatdd'],{stdio:'inherit'});process.exit(result.status??1)"
            ],
            "timeoutMs": 120000
          }
        ]
      }
    ]
  },
  "acceptance": {
    "AC-01": [
      "check:broad-project",
      "batch:automatic-delivery"
    ],
    "AC-02": [
      "check:broad-project",
      "batch:automatic-delivery"
    ],
    "AC-03": [
      "check:focused-delivery",
      "check:broad-project",
      "batch:manual-objection"
    ],
    "AC-04": [
      "check:focused-delivery",
      "check:broad-project",
      "batch:manual-objection"
    ],
    "AC-05": [
      "check:module-delivery",
      "check:broad-project",
      "batch:compatibility-package"
    ]
  },
