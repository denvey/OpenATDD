        "classification": "AUTO",
        "blocking": true,
        "title": "确定性技术改动验证后直接交付",
        "given": "任务的阻塞验收标准均可由命令或测试确定性验证，且没有要求人工判断的验收表面。",
        "when": "完成正式 finalization。",
        "then": "系统进入 `DELIVERED`，报告明确列出已通过证据，不要求人重复执行测试，也不增加第三次批准。",
        "evidence": "状态机与报告渲染测试覆盖纯内部接口、重构或同类全自动验收任务。"
      },
      {
        "id": "AC-02",
        "classification": "AUTO",
        "blocking": true,
        "title": "接口与业务契约提供结果供人按需检查",
        "given": "任务包含内部或对外 API、业务契约或 `ASSISTED` 验收表面，AI 已执行可自动完成的验证。",
        "when": "负责人打开验收报告查看请求、响应、状态码、权限、异常和副作用等结果。",
        "then": "负责人不必为了形式重新调用接口，也不必回复“批准”；没有异议即维持 `DELIVERED`，有异议则反馈具体问题。",
        "evidence": "API/辅助验收 fixture 的状态、报告、通知与无额外批准断言。"
      },
      {
        "id": "AC-03",
        "classification": "AUTO",
        "blocking": true,
        "title": "只有真正需要人执行的场景附带人工 UAT",
        "given": "任务存在阻塞的 `MANUAL` 验收标准，例如主观视觉、真实设备、生产权限或无法自动观察的第三方行为。",
        "when": "完成正式 finalization。",
        "then": "系统仍进入 `DELIVERED`，但报告清楚区分 AI 已验证部分和建议人执行的 UAT 步骤；人执行后没有问题无需回复，发现问题才提出异议。",
        "evidence": "阻塞与非阻塞 `MANUAL` 组合的报告路由测试。"
      },
      {
        "id": "AC-04",
        "classification": "AUTO",
        "blocking": true,
        "title": "人的异议会重开同一个任务",
        "given": "任务已经 `DELIVERED`，用户查看结果或执行人工 UAT 时发现与需求验收卡不符。",
        "when": "用户描述具体异议，无需填写新卡。",
        "then": "系统进入修复流程，记录缺陷、重新验证完整旅程并再次交付；没有异议时不产生额外状态转换。",
        "evidence": "已交付任务的缺陷重开、修复和重新 finalization 测试。"
      },
      {
        "id": "AC-05",
        "classification": "AUTO",
        "blocking": true,
        "title": "现有任务与命令保持兼容",
        "given": "项目已有 `AUTO`、`ASSISTED`、`MANUAL` 契约、历史任务和 finalization manifest。",
        "when": "升级后继续使用现有 CLI 创建、恢复、验证和 finalize 任务。",
        "then": "旧 `READY_FOR_UAT` 数据可读取；现有验证语义不削弱；CLI 输出、README、Skill 指令和测试与异议驱动的交付闭环一致。",
        "evidence": "完整项目测试、旧状态 fixture 回归测试和 npm 打包检查。"
      }
